# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is listed in .gitignore.

# --- Core -------------------------------------------------------------
# true for local development only. Production must use false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Comma-separated hostnames (no scheme)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins WITH scheme, e.g. https://yourdomain.com,https://www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public base URL used in canonical / Open Graph tags, e.g. https://yourdomain.com
SITE_URL=

# --- Database ---------------------------------------------------------
# Leave empty to use SQLite (db.sqlite3). Production: PostgreSQL URL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Media (uploaded photo, screenshots, resume PDF) -------------------
# Absolute path on a persistent disk in production, e.g. /var/data/media
MEDIA_ROOT=
SERVE_MEDIA=true

# --- Contact form -----------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
# true only behind a trusted reverse proxy (set automatically on Render)
CONTACT_TRUST_PROXY=false

# --- Optional email notifications --------------------------------------
# Without EMAIL_HOST, messages are only saved to the database.
CONTACT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# --- Production security (defaults shown) -------------------------------
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
